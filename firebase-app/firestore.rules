rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner() {
      return request.auth != null &&
        request.auth.uid == get(/databases/$(database)/documents/wholesaleAccess/owner).data.uid;
    }
    function workspacePath() {
      return /databases/$(database)/documents/wholesale/main;
    }
    function oldRevision() {
      return exists(workspacePath()) ? get(workspacePath()).data.revision : 0;
    }
    function oldNext() {
      return exists(workspacePath()) ? get(workspacePath()).data.next : 1;
    }
    function advancing() {
      return getAfter(workspacePath()).data.revision == oldRevision() + 1;
    }
    function validProduct(p, id) {
      return p.keys().hasOnly(['id','name','barcode','pack','carton','loose','hsn','tax','stock','cost','unit','packing','mrp']) &&
        (!('packing' in p) || (p.packing is list && p.packing.size() <= 5 && p.unit is string && p.unit.size() > 0 && p.unit.size() <= 30 && p.mrp is int && p.mrp >= 0)) &&
        p.id == id && p.name is string && p.name.size() > 0 && p.name.size() <= 200 &&
        p.barcode is string && p.barcode.size() <= 200 && p.hsn is string && p.hsn.size() <= 200 &&
        p.pack is int && p.pack >= 1 && p.pack <= 10000 &&
        p.stock is int && p.stock >= 0 &&
        p.carton is int && p.carton >= 0 && p.loose is int && p.loose >= 0 &&
        p.tax is number && p.tax >= 0 && p.tax <= 100 && p.cost is number && p.cost >= 0;
    }

    // Rebuild workspace. Existing wholesale/main data remains separate.
    match /erp/main/{kind}/{id} {
      function versionBefore() {
        return exists(/databases/$(database)/documents/erp/main/$(kind)/$(id)) ? resource.data.version : 0;
      }
      function posted() {
        let operation = request.resource.data.operationId;
        let path = /databases/$(database)/documents/erp/main/operations/$(operation);
        return operation is string && !exists(path) &&
          getAfter(path).data.actor == request.auth.uid;
      }
      function versioned() {
        return request.resource.data.id == id &&
          request.resource.data.version is int &&
          request.resource.data.version == versionBefore() + 1 &&
          posted();
      }
      function knownKind() {
        return kind in ['items','parties','orders','documents','movements','visits','closings','settings'];
      }
      function validRecord() {
        let d = request.resource.data;
        return (kind != 'items' || (d.name is string && d.name.size() > 0 &&
          d.unit is string && d.packs is list && d.packs.size() <= 5 &&
          d.stock is int && d.stock >= 0 && d.price is int && d.price >= 0 &&
          d.cost is number && d.cost >= 0 && d.mrp is int && d.mrp >= 0 &&
          d.tax is number && d.tax >= 0 && d.tax <= 100)) &&
          (kind != 'parties' || (d.name is string && d.name.size() > 0 &&
           d.role in ['Customer','Supplier'] && d.address is string && d.area is string && d.prices is list)) &&
          (kind != 'documents' || (d.total is int && d.total >= 0 && d.dueDelta is int &&
           d.type is string && d.date is string && d.actor == request.auth.uid)) &&
          (kind != 'orders' || (d.lines is list && d.lines.size() > 0 && d.lines.size() <= 50 && d.partyId is string)) &&
          (kind != 'movements' || (d.quantity is int && d.source is string && d.itemId is string));
      }
      allow read: if owner() && (knownKind() || kind in ['operations','control']);
      allow create: if owner() && knownKind() && versioned() && validRecord();
      allow update: if owner() && kind in ['items','parties','orders','visits','settings','documents'] &&
        versioned() && validRecord() &&
        (kind != 'documents' || request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['delivery','deliveredDate','version','operationId']));
      allow create: if owner() && kind == 'operations' &&
        request.resource.data.keys().hasOnly(['actor','date','type','result']) &&
        request.resource.data.actor == request.auth.uid &&
        getAfter(/databases/$(database)/documents/erp/main/control/generation).data.operationId == id;
      allow create, update: if owner() && kind == 'control' && id == 'generation' &&
        request.resource.data.keys().hasOnly(['value','operationId']) &&
        request.resource.data.value is int &&
        request.resource.data.value == (exists(/databases/$(database)/documents/erp/main/control/generation) ? resource.data.value : 0) + 1 &&
        posted();
    }
    match /wholesale/main {
      allow read: if owner();
      allow create, update: if owner() && advancing() && validWorkspace();
      function validWorkspace() {
        let d = request.resource.data;
        let receipt = /databases/$(database)/documents/wholesale/main/commands/$(d.lastCommand);
        return d.keys().hasOnly(['revision','next','shop','lastCommand']) &&
          d.revision is int && d.next is int && (d.next == oldNext() || d.next == oldNext() + 1) &&
          d.shop.keys().hasOnly(['name','gstin','address']) &&
          d.shop.name is string && d.shop.name.size() > 0 && d.shop.name.size() <= 200 &&
          d.shop.gstin is string && d.shop.gstin.size() <= 200 &&
          d.shop.address is string && d.shop.address.size() <= 200 &&
          !exists(receipt) && existsAfter(receipt) &&
          (d.next == oldNext()
            ? getAfter(receipt).data.entryId == null
            : getAfter(receipt).data.entryId == oldNext() &&
              existsAfter(/databases/$(database)/documents/wholesale/main/entries/$(string(oldNext()))));
      }
      match /products/{id} {
        allow read: if owner();
        allow create, update: if owner() && advancing() && validProduct(request.resource.data,id);
      }
      match /entries/{id} {
        allow read: if owner();
        allow create: if owner() && advancing() &&
          getAfter(workspacePath()).data.next == oldNext() + 1 &&
          id == string(oldNext()) && request.resource.data.id == oldNext() &&
          request.resource.data.actor == request.auth.uid &&
          request.resource.data.type is string && request.resource.data.date is string &&
          request.resource.data.party is string && request.resource.data.total is int &&
          request.resource.data.total >= 0 && request.resource.data.due is int;
      }
      match /customers/{id} {
        allow read: if owner();
        allow create, update: if owner() && advancing() &&
          request.resource.data.keys().hasOnly(['id','name','area','address']) &&
          request.resource.data.id == id &&
          request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120 &&
          request.resource.data.area is string && request.resource.data.area.size() > 0 && request.resource.data.area.size() <= 120 &&
          request.resource.data.address is string && request.resource.data.address.size() > 0 && request.resource.data.address.size() <= 120;
      }
      match /orders/{id} {
        allow read: if owner();
        allow create, update: if owner() && advancing() &&
          request.resource.data.keys().hasOnly(['id','party','area','date','lines','dispatches','customerId','address']) &&
          (!('customerId' in request.resource.data) || (request.resource.data.customerId is string && request.resource.data.address is string && request.resource.data.address.size() <= 120)) &&
          (request.method == 'create' || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lines','dispatches'])) &&
          request.resource.data.id == id &&
          request.resource.data.party is string && request.resource.data.party.size() <= 120 &&
          request.resource.data.area is string && request.resource.data.area.size() <= 120 &&
          request.resource.data.date is string &&
          request.resource.data.lines is list && request.resource.data.lines.size() > 0 &&
          request.resource.data.lines.size() <= 12 && request.resource.data.dispatches is list;
      }
      match /commands/{id} {
        allow get: if owner();
        allow create: if owner() && advancing() &&
          getAfter(workspacePath()).data.lastCommand == id &&
          request.resource.data.keys().hasOnly(['entryId']);
      }
    }
  }
}
